---
import "../styles/global.css";
import Topbar from "../components/Topbar.astro";

interface Props {
  title?: string;
  currentPath?: string;
  fullWidth?: boolean;
  compactMobile?: boolean;
}

const { title = "Phrase Follower", currentPath, fullWidth = false, compactMobile = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground overflow-x-hidden">
    <div class="min-h-screen bg-background w-full">
      <Topbar currentPath={currentPath} />
      <main
        class={fullWidth
          ? "w-full px-0 md:px-4 py-2 md:py-6"
          : `container mx-auto px-3 sm:px-4 ${compactMobile ? "py-2 sm:py-6" : "py-6"}`}
      >
        <slot />
      </main>
    </div>
    <div id="toast-root"></div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
