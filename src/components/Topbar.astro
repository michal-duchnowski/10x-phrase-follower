---
import { Button } from "./ui/button";
import ConfigStatusBadge from "./ConfigStatusBadge";
import LogoutButton from "./LogoutButton";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

// Check if we're in development mode for DEV_JWT
const isDev = import.meta.env.NODE_ENV === "development";
---

<nav class="border-b border-border bg-card">
  <div class="flex h-14 items-center justify-between gap-2 px-3 sm:hidden">
    <a href="/notebooks" class="shrink-0 whitespace-nowrap text-sm font-bold text-foreground">Phrase Follower</a>
    <div class="flex items-center">
      <a
        href="/notebooks"
        aria-label="Notebooks"
        title="Notebooks"
        aria-current={currentPath.startsWith("/notebooks") ? "page" : undefined}
        class={`flex size-11 items-center justify-center rounded-md hover:bg-accent ${currentPath.startsWith("/notebooks") ? "text-primary" : "text-muted-foreground"}`}
      >
        <svg class="size-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 3H20v19H6.5A2.5 2.5 0 0 1 4 19.5v-14A2.5 2.5 0 0 1 6.5 3Z"
          ></path>
          <path d="M8 7h8M8 11h6"></path>
        </svg>
      </a>
      <a
        href="/flashcards"
        aria-label="Flashcards"
        title="Flashcards"
        aria-current={currentPath.startsWith("/flashcards") ? "page" : undefined}
        class={`flex size-11 items-center justify-center rounded-md hover:bg-accent ${currentPath.startsWith("/flashcards") ? "text-primary" : "text-muted-foreground"}`}
      >
        <svg class="size-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="7" width="15" height="14" rx="2"></rect>
          <path d="M7 3h12a2 2 0 0 1 2 2v12M7 12h7M7 16h4"></path>
        </svg>
      </a>
      <details class="group relative">
        <summary
          aria-label="More navigation options"
          title="More"
          class="flex size-11 cursor-pointer list-none items-center justify-center rounded-md text-muted-foreground hover:bg-accent [&::-webkit-details-marker]:hidden"
        >
          <svg class="size-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
            <circle cx="5" cy="12" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="19" cy="12" r="2"
            ></circle>
          </svg>
        </summary>
        <div class="absolute right-0 z-40 mt-1 min-w-40 rounded-md border border-border bg-card p-2 shadow-lg">
          <a href="/import" class="flex min-h-11 items-center rounded px-3 text-sm hover:bg-accent">Import</a>
          <a href="/settings" class="flex min-h-11 items-center rounded px-3 text-sm hover:bg-accent">Settings</a>
          <div class="mobile-logout border-t border-border pt-1"><LogoutButton client:load showLabel /></div>
        </div>
      </details>
    </div>
  </div>
  <div class="container mx-auto hidden px-4 sm:block">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo and main navigation -->
      <div class="flex items-center space-x-6">
        <a
          href="/notebooks"
          class="whitespace-nowrap text-sm md:text-lg font-bold text-foreground hover:text-primary transition-colors"
        >
          Phrase Follower
        </a>

        <div class="flex items-center space-x-4">
          <a
            href="/notebooks"
            class={`text-sm font-medium transition-colors hover:text-primary ${
              currentPath === "/notebooks" || currentPath?.startsWith("/notebooks/")
                ? "text-primary"
                : "text-muted-foreground"
            }`}
          >
            Notebooks
          </a>
          <a
            href="/import"
            class={`text-sm font-medium transition-colors hover:text-primary ${
              currentPath === "/import" ? "text-primary" : "text-muted-foreground"
            }`}
            title="Import"
          >
            <svg class="h-4 w-4 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
            </svg>
            <span class="hidden sm:inline">Import</span>
          </a>
          <a
            href="/flashcards"
            class={`text-sm font-medium transition-colors hover:text-primary ${currentPath === "/flashcards" ? "text-primary" : "text-muted-foreground"}`}
            >Flashcards</a
          >
        </div>
      </div>

      <!-- Right side navigation -->
      <div class="flex items-center space-x-4">
        <!-- TTS Config Status Badge - hidden on mobile -->
        <div class="hidden md:flex items-center">
          <ConfigStatusBadge client:load />
        </div>

        <!-- Settings gear icon -->
        <Button variant="ghost" size="sm" className="p-2" asChild>
          <a href="/settings" class="text-muted-foreground hover:text-foreground transition-colors">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
          </a>
        </Button>

        <!-- User menu -->
        <div class="flex items-center space-x-2">
          {
            isDev && (
              <span class="text-xs px-2 py-1 rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">
                DEV
              </span>
            )
          }
          <LogoutButton client:load />
        </div>
      </div>
    </div>
  </div>
</nav>
